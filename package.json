{
	"name": "gatekeeper",
	"version": "0.1.2",
	"private": true,
	"type": "module",
	"description": "Community publisher tooling for PermawebOS Browser Gatekeeper site and address protection lists.",
	"scripts": {
		"build": "node --import tsx src/build.ts",
		"publish": "node --import tsx src/publish.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"update:sites": "node --import tsx src/updateSites.ts",
		"validate": "node --import tsx src/validate.ts"
	},
	"dependencies": {
		"arweave": "^1.15.7",
		"yaml": "^2.8.1"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"tsx": "^4.20.4",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=20"
	}
}
